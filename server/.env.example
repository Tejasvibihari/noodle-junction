NODE_ENV=development
PORT=5000

# Public URLs
APP_URL_API=http://localhost:5000
APP_URL_CLIENT=http://localhost:3000
# Comma-separated allowlist of browser origins
CORS_ORIGINS=http://localhost:3000
# Set in production so the guest session cookie is first-party, e.g. .noodlejunction.in
COOKIE_DOMAIN=

# Data stores (MongoDB must be a replica set: transactions + change streams)
MONGODB_URI=mongodb://localhost:27017/noodle-junction?replicaSet=rs0
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata
